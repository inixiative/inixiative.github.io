---
// Pages with a primary page of their own; the section buckets are in the top nav.
const pages = [
  { href: "/foundry/", label: "Foundry" },
  { href: "https://kingdom.inixiative.com", label: "Kingdom" },
  { href: "/moving-forward/", label: "Moving forward" },
];
// Marks from simple-icons (CC0), drawn in currentColor.
const elsewhere = [
  {
    href: "https://github.com/inixiative",
    label: "GitHub",
    path: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  },
  {
    href: "https://www.npmjs.com/org/inixiative",
    label: "npm",
    path: "M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z",
  },
  {
    href: "https://inixiative.substack.com",
    label: "Substack",
    path: "M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z",
  },
  {
    href: "https://x.com/inixiative",
    label: "X",
    path: "M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z",
  },
];
---
<footer class="shell site-footer">
  <div class="footer">
    <ul class="footer-links" aria-label="Pages">
      {pages.map((page) => <li><a href={page.href}>{page.label}</a></li>)}
    </ul>
  </div>
  <div class="footer-base">
    <p class="contributors">Built by Aron Greenspan.</p>
    <ul class="footer-social" aria-label="inixiative elsewhere">
      {elsewhere.map((site) => (
        <li>
          <a href={site.href} aria-label={`inixiative on ${site.label}`}>
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path fill="currentColor" d={site.path} /></svg>
            <span>{site.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
