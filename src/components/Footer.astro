---
import { elsewhere } from "../data/elsewhere";
// Pages with a primary page of their own; the section buckets are in the top nav.
const pages = [
  { href: "/foundry/", label: "Foundry" },
  { href: "/foundry/demo/", label: "Foundry demo" },
  { href: "https://kingdom.inixiative.com", label: "Kingdom" },
  { href: "/moving-forward/", label: "Moving forward" },
];
---
<footer class="shell site-footer">
  <div class="footer">
    <ul class="footer-links" aria-label="Pages">
      {pages.map((page) => <li><a href={page.href}>{page.label}</a></li>)}
    </ul>
  </div>
  <div class="footer-base">
    <p class="contributors">Built by Aron Greenspan.</p>
    <ul class="footer-social" aria-label="inixiative elsewhere">
      {elsewhere.map((site) => (
        <li>
          <a href={site.href} aria-label={`inixiative on ${site.label}`}>
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path fill="currentColor" d={site.path} /></svg>
            <span>{site.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
