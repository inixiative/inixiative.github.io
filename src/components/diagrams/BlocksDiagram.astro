---
// Template holds four of the pieces; transitions stands on its own (checked against template's package.json files).
const inside = [
  { plain: "Rules", name: "json-rules", x: 22, y: 64 },
  { plain: "Who can do what", name: "permissions", x: 150, y: 64 },
  { plain: "Rule screens", name: "rules-builder", x: 22, y: 132 },
  { plain: "Data shape", name: "prisma-map", x: 150, y: 132 },
];
---
<svg class="diagram" viewBox="0 0 400 240" role="img" aria-labelledby="blocks-diagram-title">
  <title id="blocks-diagram-title">Template holds the pieces; each piece also works on its own.</title>
  <rect class="d-frame d-accent-line" x="12" y="20" width="268" height="200" rx="14" />
  <text class="d-label d-accent-text" x="24" y="46">template · the whole app</text>
  {inside.map((b) => (
    <g>
      <rect class="d-brick" x={b.x} y={b.y} width="120" height="56" rx="8" />
      <text class="d-plain" x={b.x + 10} y={b.y + 25}>{b.plain}</text>
      <text class="d-name" x={b.x + 10} y={b.y + 43}>{b.name}</text>
    </g>
  ))}
  <rect class="d-brick d-accent-fill" x="296" y="98" width="96" height="56" rx="8" />
  <text class="d-plain" x="306" y="123">Next steps</text>
  <text class="d-name" x="306" y="141">transitions</text>
  <text class="d-note" x="296" y="180">any piece</text>
  <text class="d-note" x="296" y="196">works alone</text>
</svg>
