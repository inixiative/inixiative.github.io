---
// Template is its own app, a whole SaaS app you start from; the pieces it is built from also work on their own.
// Pieces in Aron's order, prisma-map first. Labels use the one shape: tag (repo name) on top, description below.
const pieces = [
  { tag: "prisma-map", desc: "Data shape" },
  { tag: "json-rules", desc: "Rules" },
  { tag: "permissions", desc: "Who can do what" },
  { tag: "transitions", desc: "Lifecycles" },
  { tag: "rules-builder", desc: "Rule screens" },
];
const py = (i: number) => 14 + i * 46;
---
<svg class="diagram" viewBox="0 0 400 264" role="img" aria-labelledby="blocks-diagram-title">
  <title id="blocks-diagram-title">Template is a whole SaaS app you start from, with sign-in, teams, settings and live data. It is built from five pieces that also work on their own: prisma-map, json-rules, permissions, transitions and rules-builder.</title>
  <!-- the app -->
  <rect class="d-brick d-accent-fill" x="12" y="14" width="208" height="224" rx="12" />
  <path class="d-faint-line d-link" d="M12 40 H 220" />
  <circle class="d-dot" cx="28" cy="27" r="3.5" />
  <circle class="d-dot" cx="40" cy="27" r="3.5" />
  <circle class="d-dot" cx="52" cy="27" r="3.5" />
  <text class="d-tag" x="26" y="64">template</text>
  <text class="d-desc" x="26" y="82">The whole SaaS app</text>
  <!-- sign-in -->
  <rect class="d-brick" x="26" y="98" width="180" height="26" rx="6" />
  <text class="d-ui" x="36" y="115">Sign in</text>
  <rect class="d-bar d-accent-fill-solid" x="160" y="105" width="36" height="12" rx="6" />
  <!-- teams -->
  <text class="d-ui" x="26" y="146">Teams</text>
  <circle class="d-member" cx="92" cy="142" r="7" />
  <circle class="d-member" cx="106" cy="142" r="7" />
  <circle class="d-member" cx="120" cy="142" r="7" />
  <!-- settings -->
  <text class="d-ui" x="26" y="174">Settings</text>
  <rect class="d-brick" x="176" y="164" width="30" height="14" rx="7" />
  <circle class="d-dot d-accent-fill-solid" cx="198" cy="171" r="5" />
  <!-- live data -->
  <text class="d-ui" x="26" y="202">Live data</text>
  <path class="d-link d-accent-line" d="M92 216 L112 204 L130 210 L150 196 L170 202 L198 188" />
  <!-- the pieces it is built from -->
  {pieces.map((p, i) => (
    <g>
      <path class="d-link d-faint-line" d={`M220 ${py(i) + 20} H 246`} />
      <rect class="d-brick" x="246" y={py(i)} width="146" height="40" rx="8" />
      <text class="d-tag" x="258" y={py(i) + 16}>{p.tag}</text>
      <text class="d-desc" x="258" y={py(i) + 32}>{p.desc}</text>
    </g>
  ))}
  <text class="d-note" x="392" y="258" text-anchor="end">each piece also works on its own</text>
</svg>
