---
// Developer experience: copies side by side (worktrees), a map of the code (atlas), notes beside it (gloss), one setup (config).
// Labels use the one shape: tag (repo name) on top, description below.
const lines = [0, 1, 2, 3, 4];
---
<svg class="diagram" viewBox="0 0 400 240" role="img" aria-labelledby="tools-diagram-title">
  <title id="tools-diagram-title">worktrees: a copy of the project per task. atlas: a map of the code. gloss: notes kept beside the code. config: one shared setup.</title>
  <text class="d-tag" x="20" y="14">worktrees</text>
  <text class="d-desc" x="20" y="31">A copy per task</text>
  <rect class="d-brick d-faint" x="48" y="40" width="150" height="150" rx="10" />
  <rect class="d-brick d-faint" x="34" y="54" width="150" height="150" rx="10" />
  <rect class="d-brick" x="20" y="68" width="150" height="150" rx="10" />
  {lines.map((i) => (
    <rect class={i === 2 ? "d-bar d-accent-fill-solid" : "d-bar"} x="36" y={92 + i * 22} width={i % 2 ? 80 : 112} height="8" rx="4" />
  ))}
  <rect class="d-brick" x="226" y="22" width="160" height="56" rx="8" />
  <text class="d-tag" x="238" y="44">atlas</text>
  <text class="d-desc" x="238" y="63">Map of the code</text>
  <circle class="d-dot" cx="336" cy="40" r="4" />
  <circle class="d-dot" cx="354" cy="40" r="4" />
  <circle class="d-dot d-accent-fill-solid" cx="372" cy="40" r="4" />
  <path class="d-link" d="M336 40 H 372" />
  <path class="d-link d-accent-line" d="M150 140 H 226" />
  <rect class="d-brick d-accent-fill" x="226" y="96" width="160" height="56" rx="8" />
  <text class="d-tag" x="238" y="118">gloss</text>
  <text class="d-desc" x="238" y="137">Notes beside the code</text>
  <rect class="d-brick" x="226" y="170" width="160" height="56" rx="8" />
  <text class="d-tag" x="238" y="192">config</text>
  <text class="d-desc" x="238" y="211">Shared setup</text>
</svg>
