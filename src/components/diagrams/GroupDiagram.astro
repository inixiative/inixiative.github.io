---
// The Inixiative project (planned), change.org meets Kickstarter on blockchain: members pool money, and it is released
// one phase at a time as they vote that each milestone was met. Label shape as on the maps: tag on top, description below.
const cx = 78, cy = 146, r = 52;
const members = [0, 1, 2, 3, 4, 5].map((i) => {
  const a = (i / 6) * Math.PI * 2 - Math.PI / 2;
  return { x: cx + r * Math.cos(a), y: cy + r * Math.sin(a) };
});
const phases = [
  { name: "Milestone 1", state: "met, funds released", tone: "done" },
  { name: "Milestone 2", state: "members voting", tone: "now" },
  { name: "Milestone 3", state: "funds held", tone: "later" },
];
const rowY = (i: number) => 98 + i * 48;
---
<svg class="diagram" viewBox="0 0 400 240" role="img" aria-labelledby="group-diagram-title">
  <title id="group-diagram-title">Members pool money. It is released one phase at a time, as they vote that each milestone was met.</title>

  <text class="d-tag" x="12" y="18">Inixiative project · planned</text>
  <text class="d-desc" x="12" y="37">change.org meets Kickstarter on blockchain</text>

  {members.map((m) => <path class="d-link d-faint-line" d={`M${m.x} ${m.y} L${cx} ${cy}`} />)}
  {members.map((m) => <circle class="d-member" cx={m.x} cy={m.y} r="9" />)}
  <circle class="d-brick d-accent-fill" cx={cx} cy={cy} r="28" />
  <text class="d-plain" x={cx} y={cy + 5} text-anchor="middle">Pool</text>

  {phases.map((p, i) => (
    <g class={p.tone === "later" ? "d-faint" : undefined}>
      <path
        class={p.tone === "done" ? "d-link d-accent-line" : p.tone === "now" ? "d-link d-dashed d-accent-line" : "d-link d-dashed"}
        d={`M${cx + 30} ${cy} C 150 ${cy}, 140 ${rowY(i)}, 172 ${rowY(i)}`}
        marker-end={p.tone === "later" ? "url(#group-arrow)" : "url(#group-arrow-accent)"}
      />
      <rect class={p.tone === "now" ? "d-brick d-accent-fill" : "d-brick"} x="176" y={rowY(i) - 20} width="212" height="40" rx="8" />
      {p.tone === "done" && <path class="d-check d-accent-line" d={`M190 ${rowY(i)} l5 5 l10 -12`} />}
      {p.tone === "now" && <circle class="d-dot d-accent-fill-solid" cx="197" cy={rowY(i)} r="4" />}
      {p.tone === "later" && <circle class="d-member" cx="197" cy={rowY(i)} r="4" />}
      <text class="d-plain" x="216" y={rowY(i) - 2}>{p.name}</text>
      <text class="d-ui" x="216" y={rowY(i) + 14}>{p.state}</text>
    </g>
  ))}

  <defs>
    <marker id="group-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto"><path class="d-arrow" d="M0 0 L8 4 L0 8 z" /></marker>
    <marker id="group-arrow-accent" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto"><path class="d-arrow d-accent-fill-solid" d="M0 0 L8 4 L0 8 z" /></marker>
  </defs>
</svg>
