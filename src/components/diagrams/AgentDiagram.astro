---
// Foundry, on one request: the Wardens that recognise it hold what the project already has (straight across),
// and remind your agent of it. Each Warden sits on the same row as the thing it holds.
const rows = [
  { warden: "paging", has: "paginate()", lit: true },
  { warden: "filters", has: "parseFilters()", lit: true },
  { warden: "sign-in", has: "Sign-in", lit: false },
];
const rowY = (i: number) => 104 + i * 40;
---
<svg class="diagram" viewBox="0 0 400 240" role="img" aria-labelledby="agent-diagram-title">
  <title id="agent-diagram-title">You ask for products with paging. Inside Foundry, the paging and filters Wardens remind your agent of the paginate and parseFilters your project already has, and your agent builds on them.</title>

  <rect class="d-brick" x="12" y="6" width="250" height="44" rx="22" />
  <text class="d-tag" x="30" y="24">you ask</text>
  <text class="d-desc" x="30" y="41">List products, with paging</text>
  <path class="d-link" d="M80 50 V 116" marker-end="url(#agent-arrow)" />

  <rect class="d-frame d-accent-line d-dashed" x="12" y="66" width="250" height="164" rx="12" />
  <text class="d-tag" x="24" y="84">foundry</text>
  <text class="d-note" x="166" y="84">Wardens</text>

  <rect class="d-brick d-accent-fill" x="24" y="120" width="112" height="56" rx="8" />
  <text class="d-tag" x="36" y="142">your agent</text>
  <text class="d-desc" x="36" y="161">Claude, Codex</text>

  <rect class="d-frame" x="284" y="66" width="108" height="164" rx="12" />
  <text class="d-note" x="296" y="84">your project</text>

  {rows.map((row, i) => (
    <g class={row.lit ? undefined : "d-faint"}>
      <rect class={row.lit ? "d-brick d-accent-fill" : "d-brick"} x="166" y={rowY(i) - 13} width="80" height="26" rx="13" />
      <text class="d-ui" x="206" y={rowY(i) + 4} text-anchor="middle">{row.warden}</text>
      <rect class="d-brick" x="294" y={rowY(i) - 13} width="88" height="26" rx="6" />
      <text class="d-ui" x="302" y={rowY(i) + 4}>{row.has}</text>
    </g>
  ))}
  {rows.filter((row) => row.lit).map((_, i) => (
    <g>
      <path class="d-link d-dashed d-accent-line" d={`M246 ${rowY(i)} H 290`} marker-end="url(#agent-arrow-accent)" />
      <path class="d-link d-accent-line" d={`M166 ${rowY(i)} C 152 ${rowY(i)}, 150 ${140 + i * 16}, 140 ${140 + i * 16}`} marker-end="url(#agent-arrow-accent)" />
    </g>
  ))}
  <text class="d-note" x="24" y="198">two reminders</text>
  <text class="d-note" x="24" y="212">reach your agent</text>

  <defs>
    <marker id="agent-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto"><path class="d-arrow" d="M0 0 L8 4 L0 8 z" /></marker>
    <marker id="agent-arrow-accent" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto"><path class="d-arrow d-accent-fill-solid" d="M0 0 L8 4 L0 8 z" /></marker>
  </defs>
</svg>
