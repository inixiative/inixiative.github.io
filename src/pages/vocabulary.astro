---
// Renders .github/VOCABULARY.md in the browser, so the page is always the current file (as /vocabulary.html did).
import Base from "../layouts/Base.astro";
const source = "https://raw.githubusercontent.com/inixiative/.github/main/VOCABULARY.md";
const github = "https://github.com/inixiative/.github/blob/main/VOCABULARY.md";
---
<Base
  title="Vocabulary · inixiative"
  description="The inixiative vocabulary: every primitive across the ecosystem and the template, with what it solves and how it works."
  domain="inixiative"
  light
>
  <section class="section">
    <article class="prose" id="content" data-source={source} data-github={github}>
      <p>Loading the vocabulary…</p>
    </article>
    <p class="meta">Source: <a class="text-link" href={github}>inixiative/.github/VOCABULARY.md</a></p>
  </section>
  <script is:inline src="https://cdn.jsdelivr.net/npm/marked@12/marked.min.js"></script>
  <script is:inline>
    (function () {
      var el = document.getElementById("content");
      fetch(el.dataset.source)
        .then(function (r) {
          if (!r.ok) throw new Error("HTTP " + r.status);
          return r.text();
        })
        .then(function (md) {
          el.innerHTML = marked.parse(md, { gfm: true });
        })
        .catch(function (err) {
          el.textContent = "Could not load the vocabulary (" + err.message + "). Read it on GitHub: " + el.dataset.github;
        });
    })();
  </script>
</Base>
