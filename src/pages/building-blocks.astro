---
import Base from "../layouts/Base.astro";
import { developerExperience, packages, templatePlain } from "../data/building-blocks";
const anchor = (name: string) => name.toLowerCase().replace(/\s+/g, "-");
---
<Base
  title="Building blocks: stop rediscovering what you need to build · inixiative"
  description="Start a product with the hard parts already built, and use the pieces for the most common problems on their own: who can do what, rules, and the steps a record moves through."
  domain="building-blocks"
  current="building-blocks"
>
  <section class="hero anchor-target" id="primitives">
    <span class="eyebrow"><span class="status-dot"></span>Building blocks</span>
    <h1 class="display-1">Stop rediscovering what you need to build.</h1>
    <p class="lede">
      Across my career I kept running into the same shapes of problem. More often than not, people
      built a one-off solution for each, often right next to another problem with the same shape. I
      built the best-shaped solution I could for each, so it can be reused wherever that problem shows
      up. Most of these pieces run in production at the company where I work.
    </p>
    <p class="meta">If your coding agent writes its own versions instead, <a class="text-link" href="/agentic/">Foundry</a> points it back at these.</p>
  </section>

  <section class="section anchor-target" id="template">
    <div class="card" data-raised>
      <div class="card-head">
        <span class="eyebrow"><span class="status-dot"></span>template</span>
        <span class="tag" data-tone="open">MIT</span>
      </div>
      <h2 class="display-3">A SaaS app where the hard parts are already built.</h2>
      <p>Template is like shadcn, but for the whole SaaS app: you start a product from it and own the code. On day one:</p>
      <ul>
        {templatePlain.map((item) => <li>{item}</li>)}
      </ul>
      <div class="card-links">
        <a class="text-link" href="/building-blocks/technical/#template">Technical details</a>
        <a class="text-link" href="https://github.com/inixiative/template">GitHub</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <span class="eyebrow" data-quiet>The pieces</span>
      <h2>For the problems almost every product has.</h2>
      <p class="lede">You can use each one without the template.</p>
    </div>
    <ol class="chain" aria-label="Dependency order">
      {packages.map((p) => <li><a href={`#${p.name}`}>{p.name}</a></li>)}
    </ol>
    <ul class="packages">
      {packages.map((p) => (
        <li class="package" id={anchor(p.name)}>
          <div class="package-name">
            <h3>{p.name}</h3>
          </div>
          <div class="package-body">
            <p class="line">{p.plain}</p>
            <div class="card-links">
              <a class="text-link" href={`/building-blocks/technical/#${anchor(p.name)}`}>Technical details</a>
              {p.demo && <a class="text-link" href={p.demo}>Live demo</a>}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="section anchor-target" id="developer-experience">
    <div class="section-heading">
      <span class="eyebrow" data-quiet>Developer experience</span>
      <h2>Tools for working on the code. None of them ships in your product.</h2>
      <p class="lede">Atlas, gloss and config are packages of their own. Worktrees, init and the CI rules come with template.</p>
    </div>
    <ul class="packages">
      {developerExperience.map((p) => (
        <li class="package" id={anchor(p.name)}>
          <div class="package-name">
            <h3>{p.name}</h3>
          </div>
          <div class="package-body">
            <p class="line">{p.plain}</p>
            <div class="card-links">
              <a class="text-link" href={`/building-blocks/technical/#${anchor(p.name)}`}>Technical details</a>
              {p.demo && <a class="text-link" href={p.demo}>Live demo</a>}
            </div>
          </div>
        </li>
      ))}
    </ul>
    <p class="meta"><a class="text-link" href="/building-blocks/technical/">Technical details for every piece</a></p>
  </section>

  <section class="section" data-compact>
    <span class="eyebrow" data-quiet>Paused</span>
    <div class="card-grid">
      <div class="card anchor-target" id="conditional-form" data-plain>
        <div class="card-head"><h3>conditional-form</h3><span class="tag" data-tone="progress">Paused</span></div>
        <p>Forms whose show, hide and validation logic is the same rules the server uses. Not recommended for use.</p>
        <div class="card-links"><a class="text-link" href="https://github.com/inixiative/conditional-form">GitHub</a></div>
      </div>
    </div>
  </section>
</Base>
