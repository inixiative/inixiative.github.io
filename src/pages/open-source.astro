---
import Base from "../layouts/Base.astro";
import { groups, foundryMitDate } from "../data/open-source";
---
<Base
  signoff
  title="Open source: what you can use, change and sell · inixiative"
  description="Almost everything inixiative publishes is MIT: use it, change it, use it at work, sell what you build. Foundry's app is free to use at work but not to resell. Kingdom and Oracle are closed."
  domain="inixiative"
  current="open-source"
>
  <section class="hero">
    <span class="eyebrow"><span class="status-dot"></span>Open source</span>
    <h1 class="display-1">What you can use, change and sell.</h1>
    <p class="lede">
      Almost everything here you can use, change, use at work and build a business on. You can use
      Foundry's app at work too, but you can't resell it. Kingdom and Oracle are closed.
    </p>
  </section>

  <section class="section" data-compact>
    <div class="text">
      <p>
        <strong>MIT</strong> means you can do anything with the code, including selling what you build
        with it, as long as you keep the copyright notice.
      </p>
      <p>
        <strong>Source-available (BSL 1.1)</strong> means you can read, run and change the code, including
        inside your company, but you can't sell it or offer it to others as a product or service. Foundry's
        app becomes MIT on {foundryMitDate}.
      </p>
    </div>
  </section>

  {groups.map((group) => (
    <section class="section" data-compact>
      <h2 class="eyebrow" data-quiet>{group.title}</h2>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th scope="col">What</th><th scope="col">What you can do</th><th scope="col">License</th><th scope="col">Link</th></tr>
          </thead>
          <tbody>
            {group.projects.map((row) => (
              <tr>
                <td><strong>{row.name}</strong>{row.state && ` (${row.state})`}<br />{row.what}</td>
                <td>{row.can}</td>
                <td>{row.licenceLabel}</td>
                <td>{row.href ? <a href={row.href}>{row.linkLabel ?? "GitHub"}</a> : "None"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  <section class="section" data-compact>
    <div class="text">
      <h2 class="eyebrow" data-quiet>Why</h2>
      <p>
        I keep the code people build on open so the lessons in it travel. I keep the hosted service and
        the tuning closed so the project can pay for itself.
      </p>
    </div>
    <div class="actions">
      <a class="button" href="https://github.com/inixiative">github.com/inixiative</a>
    </div>
  </section>
</Base>
