---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import StackMap from "../components/StackMap.astro";
import StackMapKey from "../components/StackMapKey.astro";

import BlocksDiagram from "../components/diagrams/BlocksDiagram.astro";
import ToolsDiagram from "../components/diagrams/ToolsDiagram.astro";
import AgentDiagram from "../components/diagrams/AgentDiagram.astro";
import GroupDiagram from "../components/diagrams/GroupDiagram.astro";
import { byLicence, foundryMitDate } from "../data/open-source";

const mitProjects = byLicence("mit");
const tiers = [
  {
    key: "mit",
    label: "MIT",
    count: mitProjects.length,
    can: "Use it, change it, sell what you build with it.",
    names: mitProjects.map((project) => (project.state === "paused" ? `${project.name} · paused` : project.name)),
  },
  {
    key: "source-available",
    label: "Source-available",
    count: byLicence("source-available").length,
    can: `Foundry's app. Free to use at work, not to resell. MIT on ${foundryMitDate}.`,
    names: byLicence("source-available").map((project) => project.name),
  },
  {
    key: "closed",
    label: "Closed",
    count: byLicence("closed").length,
    can: "Kingdom runs as a hosted service. Oracle is not published.",
    names: byLicence("closed").map((project) => project.name),
  },
];
---
<Base
  title="inixiative: technology for cooperation"
  description="Aron Greenspan's open building blocks for SaaS apps, a workspace that gets coding agents to use what your codebase already has, and designs for cooperation."
  domain="inixiative"
>
  <script slot="head" is:inline>
    // Every primitive's GitHub homepage, and posts from before the rebuild, link to /#<repo>.
    // Those sections now live on their own pages; send the old anchors there.
    (function () {
      var id = location.hash.slice(1);
      if (!id) return;
      var blocks = ["primitives", "template", "json-rules", "permissions", "transitions", "prisma-map", "atlas", "rules-builder", "config", "gloss", "conditional-form"];
      var agentic = ["foundry", "agent-session", "archive", "signet", "kcp", "kingdom", "oracle", "bench", "hivemind"];
      var target = null;
      if (id === "think" || id === "governance") target = "/governance/";
      else if (id === "agentic") target = "/agentic/";
      else if (id === "building-blocks") target = "/building-blocks/";
      else if (id === "foundry-oracle") target = "/agentic/#oracle";
      else if (blocks.indexOf(id) !== -1) target = "/building-blocks/#" + id;
      else if (agentic.indexOf(id) !== -1) target = "/agentic/#" + id;
      if (target) location.replace(target);
    })();
  </script>

  <section class="hero hero-split">
    <div class="hero-copy">
      <span class="hero-mark"><Mark /></span>
      <h1 class="display-1">Technology for cooperation.</h1>
      <p class="lede">
        A decade of lessons from building software, packaged so you don't have to figure the same things
        out on every project.
      </p>
      <StackMapKey view="whole" standalone />
    </div>
    <div class="hero-map">
      <StackMap view="whole" hero />
    </div>
  </section>

  <section class="section areas" aria-label="What inixiative builds">
    <article class="area" data-domain="building-blocks" aria-labelledby="building-blocks-title">
      <div class="area-text">
        <span class="eyebrow"><span class="status-dot"></span>Building blocks</span>
        <h2 id="building-blocks-title" class="display-3">Stop rediscovering what you need to build.</h2>
        <p>Start a product with the hard parts already built, or use the pieces for the most common problems on their own.</p>
        <a class="text-link" href="/building-blocks/">The building blocks</a>
      </div>
      <figure class="area-figure"><BlocksDiagram /></figure>
    </article>

    <article class="area" data-domain="inixiative" aria-labelledby="developer-experience-title">
      <div class="area-text">
        <span class="eyebrow"><span class="status-dot"></span>Developer experience</span>
        <h2 id="developer-experience-title" class="display-3">Tools for working on the code.</h2>
        <p>These tools help me build, and none of them ends up in your product.</p>
        <a class="text-link" href="/building-blocks/#developer-experience">Developer experience</a>
      </div>
      <figure class="area-figure"><ToolsDiagram /></figure>
    </article>

    <article class="area" data-domain="agentic" aria-labelledby="agentic-title">
      <div class="area-text">
        <span class="eyebrow"><span class="status-dot"></span>Agentic</span>
        <h2 id="agentic-title" class="display-3">An agent that works like you do.</h2>
        <p>Foundry points your coding agent at what your project already has, so you stop repeating yourself.</p>
        <div class="area-links">
          <a class="text-link" href="/agentic/">The agentic tools</a>
          <a class="text-link" href="/foundry/">How Foundry works</a>
        </div>
      </div>
      <figure class="area-figure"><AgentDiagram /></figure>
    </article>

    <article class="area" data-domain="governance" aria-labelledby="governance-title">
      <div class="area-text">
        <span class="eyebrow"><span class="status-dot"></span>Governance</span>
        <h2 id="governance-title" class="display-3">Designs for cooperation at scale.</h2>
        <p>The long-term goal is tools for people, and their agents, to cooperate.</p>
        <a class="text-link" href="/governance/">The proposals</a>
      </div>
      <figure class="area-figure">
        <GroupDiagram />
        <figcaption>Planned: the Inixiative project, change.org meets Kickstarter. Funding is released in phases as participants vote that each milestone was met.</figcaption>
      </figure>
    </article>
  </section>

  <section class="section story" aria-labelledby="open-source-title">
    <div class="section-heading">
      <span class="eyebrow"><span class="status-dot"></span>Open source</span>
      <h2 id="open-source-title">Committed to open source.</h2>
      <p class="lede">Almost everything we build is MIT. Here's how the rest splits.</p>
    </div>
    <ul class="licence-tiers">
      {tiers.map((tier) => (
        <li class="licence-tier" data-licence={tier.key}>
          <div class="licence-head">
            <span class="licence-count">{tier.count}</span>
            <span class="licence-label">{tier.label}</span>
          </div>
          <p class="licence-can">{tier.can}</p>
          <ul class="licence-names">
            {tier.names.map((name) => <li>{name}</li>)}
          </ul>
        </li>
      ))}
    </ul>
    <div class="actions">
      <a class="button button-secondary" href="/open-source/">The full table</a>
    </div>
  </section>
</Base>
